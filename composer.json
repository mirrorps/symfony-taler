{
    "name": "mirrorps/symfony-taler",
    "description": "Symfony bundle for GNU Taler payment integration via mirrorps/taler-php",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["symfony", "taler", "payment", "gnu-taler", "merchant"],
    "require": {
        "php": ">=8.1",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/config": "^6.4 || ^7.0",
        "mirrorps/taler-php": "^1.0",
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/psr7": "^2.0",
        "php-http/guzzle7-adapter": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0 || ^11.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "MirrorPS\\TalerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MirrorPS\\TalerBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
